# Modèle du fichier .env.local (NE JAMAIS mettre de vraie clé dans CE fichier : il peut être partagé).
# 1) Copiez ce fichier et renommez la copie en .env.local
# 2) Remplissez les valeurs (Supabase > Project Settings > API ; Anthropic > console > API Keys)

# Supabase : adresse du projet et clé publique "anon"
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic : clé SECRÈTE (serveur uniquement, jamais NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Supabase : clé SECRÈTE (serveur uniquement, jamais NEXT_PUBLIC_) — Settings > API Keys > Secret key
# Sert seulement au paiement Stripe (activer la licence d'une équipe quand elle paie)
SUPABASE_SECRET_KEY=

# Stripe (commencez en MODE TEST : clés sk_test_…)
# Clé secrète : Stripe > Développeurs > Clés API
STRIPE_SECRET_KEY=
# Prix de l'offre Équipe (99 €/mois) : Stripe > Catalogue de produits > votre produit > identifiant du prix (price_…)
STRIPE_PRICE_EQUIPE=
# Prix de l'offre Solo (29 €/mois, récurrent mensuel) : même endroit (price_…)
STRIPE_PRICE_SOLO=
# Secret du webhook (whsec_…) : donné par « stripe listen » en local, ou Stripe > Développeurs > Webhooks en ligne
STRIPE_WEBHOOK_SECRET=

# Emails automatiques (Resend) : resend.com > API Keys (re_…)
RESEND_API_KEY=
# Expéditeur. Pour tester SANS nom de domaine, gardez l'adresse d'essai de Resend :
# elle n'envoie qu'à l'email de VOTRE compte Resend.
EMAIL_EXPEDITEUR=Diagnostic IA <onboarding@resend.dev>
# Mot de passe de la tâche automatique du matin (inventez 32 caractères au hasard, sans espace).
# Mettez EXACTEMENT le même dans Vercel > Settings > Environment Variables.
CRON_SECRET=
# Adresse du site en ligne, pour les liens dans les emails (laisser vide sur votre ordinateur)
SITE_URL=
